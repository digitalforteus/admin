#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
|------------------------------------------------------------------------------
| Template initialisation
|------------------------------------------------------------------------------
|
| Configure a new application created from this template, and leave it running.
| Run this once from the repository root of a fresh clone:
|
|     php init
|
| It rewrites the template's identity out of source and into the environment,
| wires the clone's remotes so the template stays upstream, installs, builds and
| checks the application, and offers to commit and push the result.
|
| Edit TEMPLATE when the template's defaults change. Nothing is written until
| the proposed values have been displayed and confirmed, and every command that
| reaches the network or the working tree is confirmed on its own.
|
*/

/*
 * What to find. Every value here is a literal that occurs in the tracked files,
 * and the rewrite is a plain string substitution over them, so an entry that
 * drifts from the file it describes stops matching and leaves the template's
 * own identity in place without failing. These are not the proposed values.
 */
const TEMPLATE = [
    'slug' => 'project',
    'title' => 'Laravel Template',
    'fallback_title' => 'Project',
    'url' => 'http://project.test',
    'database' => 'app',
    'admin_email' => 'admin@example.com',
    'support_email' => 'hello@example.com',
];

/*
 * What to propose. These are only ever offered as the answer in brackets, so
 * they are free to be anything; the ones the questions derive from the clone
 * itself are computed where they are asked.
 */
const DEFAULTS = [
    'description' => '',
    'url' => 'http://localhost',
    'email' => 'admin@digitalforte.us',
    'organisation' => 'digitalforte',
];

const SKIP_DIRECTORIES = ['.git', '.idea', 'vendor', 'build', 'node_modules', 'storage'];
const SKIP_FILES = ['init', 'composer.lock', 'package-lock.json', '.env', '.DS_Store'];

/*
 * The upstream this repository is a clone of. A remote pointing here is the
 * template remote whatever it is currently called; every other remote is the
 * project's own. Renaming the wrong one costs the shared ancestry the merge
 * scheme depends on, so the classification is by url, never by name.
 */
const TEMPLATE_REMOTE = 'template';
const TEMPLATE_REPOSITORY = 'https://github.com/digitalforteus/laravel-template.git';
const TEMPLATE_MARKER = 'laravel-template';

/** The bring-up sequence, in order. A failure stops the run. */
const BUILD = [
    'Installing PHP dependencies' => 'composer update --ignore-platform-reqs',
    'Starting Sail' => './vendor/bin/sail up -d',
    'Installing node modules' => './vendor/bin/sail npm install',
    'Generating the application key' => 'php artisan key:generate',
    'Formatting' => 'composer fix',
    'Building assets' => './vendor/bin/sail npm run build',
    'Checking' => 'composer check',
];

$root = __DIR__;

if (getcwd() !== $root || ! is_file($root.'/artisan') || ! is_file($root.'/composer.json')) {
    fwrite(STDERR, "init: run this from the repository root.\n");

    exit(1);
}

writeln('');
writeln('  Laravel application template');
writeln('  Press enter to accept the value in brackets.');

$answers = [];

do {
    $answers = ask_all($root, $answers);
    summarise($answers);
} while (! confirm('Write these values', true));

$changed = rewrite($root, replacements($answers), $answers);

writeln('');
writeln(sprintf('  Rewrote %d file%s.', $changed, $changed === 1 ? '' : 's'));

configure_git();
link_remotes($answers);

$origin = project_origin();

if (confirm('Install dependencies and bring the application up', true) && ! build($root)) {
    writeln('');
    writeln('  Stopped. Fix the failure above and run the remaining steps yourself:');
    writeln('');

    foreach (BUILD as $command) {
        writeln('    '.$command);
    }

    writeln('');

    exit(1);
}

if (confirm('Delete init', true)) {
    remove_self($root);
}

commit($answers);

if ($origin === null) {
    writeln('');
    writeln('  No project origin, so nothing is pushed.');
} elseif (confirm('Push '.branch().' to '.$origin, true)) {
    step('Pushing', 'git push -u origin '.branch());
}

writeln('');
writeln('  Done. '.$answers['title'].' is configured at '.$answers['url'].'.');
writeln('');
writeln('  Set ADMIN_PASSWORD in .env and migrate to create the admin account.');
writeln('  Pull template changes with: git pull '.TEMPLATE_REMOTE.' '.branch());
writeln('');

exit(0);

/**
 * @param  array<string, string>  $previous
 * @return array<string, string>
 */
function ask_all(string $root, array $previous = []): array
{
    writeln('');

    $was = static fn (string $key, string $fallback): string => $previous[$key] ?? $fallback;
    $slug = slugify(ask('Project slug', $was('slug', slugify(basename($root)) ?: TEMPLATE['slug'])));
    $title = ask('Application name', $was('title', titleise($slug)));
    $organisation = slugify(ask('GitHub organisation', $was('organisation', DEFAULTS['organisation'])));

    return [
        'slug' => $slug,
        'title' => $title,
        'description' => ask('Description', $was('description', DEFAULTS['description'])),
        'url' => ask('Application URL', $was('url', DEFAULTS['url'])),
        'database' => database_name(ask('Database name', $was('database', str_replace('-', '_', $slug)))) ?: TEMPLATE['database'],
        'admin_email' => ask('Admin email', $was('admin_email', DEFAULTS['email'])),
        'support_email' => ask('Support email', $was('support_email', git('config user.email') ?: DEFAULTS['email'])),
        'organisation' => $organisation,
        'author' => ask('Author name', $was('author', git('config user.name'))),
        'author_email' => ask('Author email', $was('author_email', git('config user.email') ?: DEFAULTS['email'])),
    ];
}

/** @param array<string, string> $answers */
function summarise(array $answers): void
{
    writeln('');
    writeln('  This is what will be written:');
    writeln('');

    $rows = [
        'Application' => $answers['title'],
        'Slug' => $answers['slug'],
        'Description' => $answers['description'],
        'URL' => $answers['url'],
        'Database' => $answers['database'],
        'Admin email' => $answers['admin_email'],
        'Support email' => $answers['support_email'],
        'Repository' => repository($answers),
        'Author' => author($answers),
    ];

    foreach ($rows as $label => $value) {
        writeln(sprintf('    %-15s %s', $label, $value ?: '(not set)'));
    }

    writeln('');
}

/**
 * @param  array<string, string>  $answers
 * @return array<string, string>
 */
function replacements(array $answers): array
{
    return [
        '"name": "project"' => '"name": "'.$answers['slug'].'"',
        'APP_NAME='.TEMPLATE['slug'] => 'APP_NAME="'.$answers['title'].'"',
        'APP_URL='.TEMPLATE['url'] => 'APP_URL='.$answers['url'],
        'DB_DATABASE='.TEMPLATE['database'] => 'DB_DATABASE='.$answers['database'],
        'ADMIN_EMAIL='.TEMPLATE['admin_email'] => 'ADMIN_EMAIL='.$answers['admin_email'],
        'BRAND_DESCRIPTION=' => 'BRAND_DESCRIPTION="'.$answers['description'].'"',
        'MAIL_FROM_ADDRESS="'.TEMPLATE['support_email'].'"' => 'MAIL_FROM_ADDRESS="'.$answers['support_email'].'"',
        "'".TEMPLATE['support_email']."'" => "'".$answers['support_email']."'",
        "'".TEMPLATE['admin_email']."'" => "'".$answers['admin_email']."'",
        "'".TEMPLATE['title']."'" => "'".$answers['title']."'",
        "'".TEMPLATE['fallback_title']."'" => "'".$answers['title']."'",
        '# '.TEMPLATE['title'] => '# '.$answers['title'],
    ];
}

/**
 * @param  array<string, string>  $replacements
 * @param  array<string, string>  $answers
 */
function rewrite(string $root, array $replacements, array $answers): int
{
    $changed = 0;

    foreach (files($root) as $file) {
        $contents = (string) file_get_contents($file);
        $rewritten = strtr($contents, $replacements);

        if ($rewritten === $contents) {
            continue;
        }

        file_put_contents($file, $rewritten);
        $changed++;
    }

    $composer = $root.'/composer.json';
    $json = json_decode((string) file_get_contents($composer), true, flags: JSON_THROW_ON_ERROR);
    $json = ['name' => composer_name($answers)] + $json;
    $json['description'] = $answers['description'];
    $json['authors'] = array_values(array_filter([author_record($answers)]));
    $json['homepage'] = repository($answers) ?: null;
    $json['support'] = repository($answers) ? ['issues' => repository($answers).'/issues'] : null;
    $json = array_filter($json, static fn (mixed $value): bool => $value !== null && $value !== []);
    file_put_contents($composer, json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL);

    return $changed + 1;
}


/*
 * Every clone must set the merge driver named by the project-owned entries, and
 * it lives in the repository's own config rather than travelling with the
 * checkout. Without it git falls back to an ordinary conflicting merge and says
 * nothing, so a clone that skipped this looks fine until a merge resolves the
 * wrong way. Rebasing a pull replays the project onto the upstream and destroys
 * the ancestry the scheme depends on, which a global preference can turn the
 * ordinary command into, so the safe value is pinned here too.
 */
function configure_git(): void
{
    git('config merge.keepours.driver true');
    git('config pull.rebase false');

    writeln('');
    writeln('  Set the project-owned merge driver and pinned merges on pull.');
}

/**
 * Name the upstream and the project's own repository apart.
 *
 * @param  array<string, string>  $answers
 */
function link_remotes(array $answers): void
{
    $remotes = remotes();
    $upstream = null;
    $own = null;

    foreach ($remotes as $name => $url) {
        if (is_upstream($url)) {
            $upstream ??= $name;

            continue;
        }

        $own ??= $name;
    }

    if ($own !== null && $own !== 'origin' && ! has_remote('origin')) {
        writeln('  Remote '.$own.' is this project, not the template: '.$remotes[$own]);

        if (confirm('Rename '.$own.' to origin', true)) {
            git('remote rename '.$own.' origin');

            if ($upstream === $own) {
                $upstream = 'origin';
            }
        }
    }

    if ($upstream !== null && $upstream !== TEMPLATE_REMOTE && ! has_remote(TEMPLATE_REMOTE)) {
        if (confirm('Rename '.$upstream.' to '.TEMPLATE_REMOTE, true)) {
            git('remote rename '.$upstream.' '.TEMPLATE_REMOTE);
            $upstream = TEMPLATE_REMOTE;
        }
    }

    if ($upstream === null && ! has_remote(TEMPLATE_REMOTE)) {
        git('remote add '.TEMPLATE_REMOTE.' '.TEMPLATE_REPOSITORY);
        writeln('  Added '.TEMPLATE_REMOTE.' '.TEMPLATE_REPOSITORY);
    }

    create_origin($answers);

    writeln('');

    foreach (remotes() as $name => $url) {
        writeln(sprintf('    %-10s %s', $name, $url));
    }
}

/** @param array<string, string> $answers */
function create_origin(array $answers): void
{
    if (project_origin() !== null) {
        return;
    }

    if (has_remote('origin')) {
        writeln('  Origin is the template, not this project. Repoint it before pushing.');

        return;
    }

    $repository = repository($answers);

    if ($repository === '') {
        writeln('  No organisation given, so no origin. Add one with: git remote add origin <url>');

        return;
    }

    if (! installed('gh')) {
        writeln('  gh not found. Create the repository, then: git remote add origin '.$repository.'.git');

        return;
    }

    $command = sprintf('gh repo create %s/%s --private --source=. --remote=origin', $answers['organisation'], $answers['slug']);

    if (! confirm('Create '.$repository.' on GitHub as a private repository', true)) {
        return;
    }

    step('Creating the repository', $command);
}

/** @param array<string, string> $answers */
function commit(array $answers): void
{
    if (git('status --porcelain') === '') {
        return;
    }

    if (! confirm('Commit the initialisation', true)) {
        return;
    }

    step('Committing', 'git add -A && git commit -m '.escapeshellarg('Initialise '.$answers['title']));
}

function build(string $root): bool
{
    if (! is_file($root.'/.env')) {
        copy($root.'/.env.example', $root.'/.env');

        writeln('');
        writeln('  Created .env from .env.example.');
    }

    foreach (BUILD as $description => $command) {
        if (! step($description, $command)) {
            return false;
        }
    }

    return true;
}

function step(string $description, string $command): bool
{
    writeln('');
    writeln('  '.$description);
    writeln('    $ '.$command);
    writeln('');

    passthru($command, $status);

    if ($status !== 0) {
        writeln('');
        writeln(sprintf('  Failed (%d): %s', $status, $command));
    }

    return $status === 0;
}

/** @return array<string, string> */
function remotes(): array
{
    $remotes = [];

    foreach (array_filter(explode("\n", git('remote'))) as $name) {
        $name = trim($name);
        $remotes[$name] = git('remote get-url '.$name);
    }

    return $remotes;
}

function has_remote(string $name): bool
{
    return array_key_exists($name, remotes());
}

function is_upstream(string $url): bool
{
    return str_contains($url, TEMPLATE_MARKER);
}

/*
 * The project's own push target, or nothing.
 *
 * A remote named origin is not evidence of one: a clone of the template arrives
 * with the upstream under that name, and pushing a project onto the upstream is
 * the one move the scheme cannot survive. Callers that write to a remote ask
 * here, so declining the rename costs a prompt rather than the template.
 */
function project_origin(): ?string
{
    $url = remotes()['origin'] ?? null;

    return $url !== null && ! is_upstream($url) ? $url : null;
}

function branch(): string
{
    return git('branch --show-current') ?: 'main';
}

function installed(string $binary): bool
{
    return trim((string) shell_exec('command -v '.$binary.' 2>/dev/null')) !== '';
}

function remove_self(string $root): void
{
    unlink(__FILE__);

    $attributes = $root.'/.gitattributes';

    if (is_file($attributes)) {
        $contents = preg_replace('#^/init\s.*\R#m', '', (string) file_get_contents($attributes));
        file_put_contents($attributes, (string) $contents);
    }
}

/** @return list<string> */
function files(string $root): array
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveCallbackFilterIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
            static fn (SplFileInfo $file): bool => $file->isDir()
                ? ! in_array($file->getFilename(), SKIP_DIRECTORIES, true)
                : ! in_array($file->getFilename(), SKIP_FILES, true),
        ),
    );

    $files = [];

    /** @var SplFileInfo $file */
    foreach ($iterator as $file) {
        if ($file->isFile()) {
            $files[] = $file->getPathname();
        }
    }

    sort($files);

    return $files;
}

function ask(string $question, string $default): string
{
    echo sprintf('  %s [%s]: ', $question, $default);
    $answer = trim((string) fgets(STDIN));

    return $answer === '' ? $default : $answer;
}

function confirm(string $question, bool $default = false): bool
{
    echo sprintf('  %s? [%s] ', $question, $default ? 'Y/n' : 'y/N');
    $answer = strtolower(trim((string) fgets(STDIN)));

    return $answer === '' ? $default : in_array($answer, ['y', 'yes'], true);
}

function writeln(string $line): void
{
    echo $line, PHP_EOL;
}

function git(string $arguments): string
{
    return trim((string) shell_exec('git '.$arguments.' 2>/dev/null'));
}

function slugify(string $value): string
{
    return trim((string) preg_replace('/-+/', '-', (string) preg_replace('/[^a-z0-9]+/', '-', strtolower($value))), '-');
}

function database_name(string $value): string
{
    return trim((string) preg_replace('/_+/', '_', (string) preg_replace('/[^a-z0-9]+/', '_', strtolower($value))), '_');
}

function titleise(string $value): string
{
    return ucwords((string) preg_replace('/[^a-zA-Z0-9]+/', ' ', $value));
}

/** @param array<string, string> $answers */
function repository(array $answers): string
{
    return $answers['organisation'] === '' ? '' : 'https://github.com/'.$answers['organisation'].'/'.$answers['slug'];
}

/** @param array<string, string> $answers */
function composer_name(array $answers): string
{
    return ($answers['organisation'] ?: 'app').'/'.$answers['slug'];
}

/** @param array<string, string> $answers */
function author(array $answers): string
{
    return trim($answers['author'].($answers['author_email'] === '' ? '' : ' <'.$answers['author_email'].'>'));
}

/**
 * @param  array<string, string>  $answers
 * @return array{name: string, email?: string}|null
 */
function author_record(array $answers): ?array
{
    if ($answers['author'] === '') {
        return null;
    }

    return array_filter(['name' => $answers['author'], 'email' => $answers['author_email']]);
}
